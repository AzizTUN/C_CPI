#include <stdio.h>

int main(){

    int N = 7 ;
    int TA[]={2,4,5,7,9,11,14};
    int TB[]={1,3,4,5,8,10,12};
    int NC = ( N * 2 );
    int TC[NC],tmp,ver=0,x=NC;
    for(int i = 0 ; i < NC ; i++){
        if(i<N)
        TC[i] = TA[i];
        else
        TC[i] = TB[i-N];
    }
    while(ver == 0){
        ver = -1 ;
        for(int i = 0 ; i< x-1 ;i++){
            if(TC[i]>TC[i+1]){
                tmp = TC[i];
                TC[i] = TC[i+1];
                TC[i+1] = tmp ;
                ver = 0;
            }
        }x--;
    }
    for(int i = 0;i<NC;i++){
        printf("%d|",TC[i]);
    }
    return 0;
}
